# 복사: cp secrets.example.env secrets.local.env 후 값 채우기
# --- API 키 (필수) ---
BRAVE_API_KEY=
MORPH_API_KEY=
NOTION_API_KEY=
EMAIL_USER=
EMAIL_PASSWORD=
HIWORKS_USER=
HIWORKS_PASSWORD=
# --- 비밀 아님(기본값 제공) ---
MORPH_ENABLED_TOOLS=edit_file
TLS_REJECT_UNAUTHORIZED=0
# --- 머신별 경로 ---
FILESYSTEM_MCP_ROOT=$HOME/ai/claude
JHW_NOTION_DIST=$HOME/ai/opencode/projects/jhw-notion/mcp-server/dist
# --- Slack 브릿지 (claude-slack-bridge) ---
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL_ID=
SLACK_ALLOWED_USER_ID=
